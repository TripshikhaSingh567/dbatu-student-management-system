# Server Configuration
PORT=5000

# MongoDB Connection String
# Replace with your actual MongoDB Atlas connection string in your local .env file
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/student_db?retryWrites=true&w=majority

# Production Frontend URL for CORS (e.g. Vercel deployment URL)
# Set to your Vercel app URL when deployed (e.g. https://dbatu-student-management-system.vercel.app)
FRONTEND_URL=https://dbatu-student-management-system.vercel.app
